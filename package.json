{
  "name": "hedge-lang",
  "private": true,
  "type": "module",
  "workspaces": [
    "toolchain/*",
    "stdlib",
    "examples/*"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "build": "npm -ws --if-present run build",
    "clean": "rimraf node_modules toolchain/**/dist stdlib/dist",
    "check": "npm-run-all --parallel --print-label --continue-on-error --print-name check:*",
    "check:ws": "npm -ws run check",
    "check:lint": "eslint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check .",
    "check:deps": "knip",
    "check:proof-refs": "node --experimental-strip-types scripts/check-proof-refs.ts",
    "conformance": "npm test --workspace=@hedge-lang/compiler-conformance-tests",
    "fix": "npm-run-all --print-label --print-name fix:*",
    "fix:lint": "eslint --fix --max-warnings=0 .",
    "fix:format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.0.1",
    "jsonc-eslint-parser": "^3.1.0",
    "knip": "^6.25.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.1.4",
    "@rolldown/binding-win32-x64-msvc": "^1.1.4"
  }
}
