{
  "name": "@hedge-lang/compiler-conformance-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run build",
    "precheck": "npm run build",
    "build": "npm-run-all build:compiler build:cli",
    "build:compiler": "npm run build --workspace=@hedge-lang/compiler",
    "build:cli": "npm run build --workspace=@hedge-lang/cli",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hedge-lang/compiler": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
