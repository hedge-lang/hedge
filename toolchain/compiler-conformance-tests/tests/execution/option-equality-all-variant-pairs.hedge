fn main() {
  let one: Option<i32> = Option::Some(1);
  let also_one: Option<i32> = Option::Some(1);
  let two: Option<i32> = Option::Some(2);
  let none: Option<i32> = Option::None;
  let other_none: Option<i32> = Option::None;
  print(one == also_one);
  print(",");
  print(one == two);
  print(",");
  print(one == none);
  print(",");
  print(none == one);
  print(",");
  print(none == other_none);
  print(",");
  print(one != two);
}
