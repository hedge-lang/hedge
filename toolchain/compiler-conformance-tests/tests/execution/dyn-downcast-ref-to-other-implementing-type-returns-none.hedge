trait Draw {
  fn draw(&self) -> i32;
}

struct Circle {
  r: i32,
}

struct Square {
  s: i32,
}

impl Draw for Circle {
  fn draw(&self) -> i32 {
    self.r
  }
}

impl Draw for Square {
  fn draw(&self) -> i32 {
    self.s
  }
}

fn side(d: &dyn Draw) -> i32 {
  match d.downcast_ref::<Square>() {
    Option::Some(s) => s.s,
    Option::None => 0 - 1,
  }
}

fn main() {
  let c = Circle { r: 3 };
  let q = Square { s: 4 };
  print(side(&c));
  print(",");
  print(side(&q));
}
