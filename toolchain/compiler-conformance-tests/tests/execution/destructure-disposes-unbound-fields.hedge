struct Loud { id: i32 }

impl Drop for Loud {
  fn drop(&mut self) { print(self.id); }
}

struct Pair { a: Loud, b: Loud }

fn main() {
  let p = Pair { a: Loud { id: 1 }, b: Loud { id: 2 } };
  let Pair { a, .. } = p;
  let arr = [Loud { id: 3 }, Loud { id: 4 }, Loud { id: 5 }];
  let [x, ..] = arr;
  print(0);
}
