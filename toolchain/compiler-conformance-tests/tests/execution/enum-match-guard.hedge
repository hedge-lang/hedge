enum Message {
  Quit,
  Move(i32, i32),
}

fn describe(m: Message, cond: bool) -> str {
  match m {
    Message::Move(x, y) if cond => "guarded-move",
    Message::Quit => "quit",
    Message::Move(x, y) => "unguarded-move",
  }
}

fn main() {
  print(describe(Message::Move(1, 2), true));
  print(",");
  print(describe(Message::Move(1, 2), false));
  print(",");
  print(describe(Message::Quit, true));
}
