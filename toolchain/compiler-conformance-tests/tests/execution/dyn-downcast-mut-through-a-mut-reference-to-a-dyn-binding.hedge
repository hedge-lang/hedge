trait Draw {
  fn draw(&self) -> i32;
}

struct Circle {
  r: i32,
}

impl Draw for Circle {
  fn draw(&self) -> i32 {
    self.r
  }
}

fn grow(d: &mut dyn Draw) {
  match d.downcast_mut::<Circle>() {
    Option::Some(c) => {
      c.r = c.r + 10;
    }
    Option::None => {}
  }
}

fn radius(d: &dyn Draw) -> i32 {
  match d.downcast_ref::<Circle>() {
    Option::Some(c) => c.r,
    Option::None => 0 - 1,
  }
}

fn main() {
  let mut d: dyn Draw = Circle { r: 3 };
  grow(&mut d);
  print(radius(&d));
}
