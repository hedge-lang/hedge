trait Draw {
  fn draw(&self) -> i32;
}

struct Circle {
  r: i32,
}

struct Other {
  n: i32,
}

impl Draw for Circle {
  fn draw(&self) -> i32 {
    self.r
  }
}

fn count(d: &dyn Draw) -> i32 {
  match d.downcast_ref::<Other>() {
    Option::Some(o) => o.n,
    Option::None => 0 - 1,
  }
}

fn main() {
  let c = Circle { r: 3 };
  print(count(&c));
}
