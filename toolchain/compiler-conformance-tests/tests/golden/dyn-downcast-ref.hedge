trait Draw {
  fn draw(&self) -> i32;
}

struct Circle {
  r: i32,
}

impl Draw for Circle {
  fn draw(&self) -> i32 {
    self.r
  }
}

fn radius(d: &dyn Draw) -> i32 {
  match d.downcast_ref::<Circle>() {
    Option::Some(c) => c.r,
    Option::None => 0 - 1,
  }
}

fn main() {
  let c = Circle { r: 3 };
  print(radius(&c));
}
